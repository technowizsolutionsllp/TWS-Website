# Copy to .dev.vars for local development and fill with random values:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Staging and production use `wrangler secret put <NAME>` with DIFFERENT values.
PEPPER=
PEPPER_EMAIL=
PII_KEY=
CHALLENGE_KEY=
# X25519 private key (raw 32 bytes, base64url) for kid k1. Its public key is embedded in the app.
TRIAL_KEY_k1=

# API docs (Swagger) Basic-auth credentials. If either is unset the docs routes answer 404.
DOCS_USER=
DOCS_PASSWORD=

# Admin pages (/admin) Basic-auth credentials. If either is unset the pages answer 404.
ADMIN_USER=
ADMIN_PASSWORD=
