{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && vinext build",
    "start": "vinext start",
    "deploy": "npm run build && wrangler deploy --config wrangler.json",
    "deploy:preview": "npm run build && wrangler versions upload --config wrangler.json",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run --config wrangler.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@cloudflare/workers-types": "5.20261120.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.0.13",
    "vitest": "^4.1.12",
    "wrangler": "4.165.0"
  },
  "type": "module"
}
